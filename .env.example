# ============================================================================
# Aura Salon Booking Platform — Environment Configuration Template (.env.example)
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Supabase Managed Postgres or Local Docker Postgres)
# Requires btree_gist extension enabled: CREATE EXTENSION IF NOT EXISTS btree_gist;
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Public & Admin Credentials
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Authentication & Session Security (HMAC-SHA256 Token Signing)
AUTH_SECRET=your_32_character_random_hex_secret_here

# GraphQL API Endpoint
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/api/graphql

# Multi-Tenancy & Regional Defaults
DEFAULT_TENANT_SLUG=bonanza
DEFAULT_TIMEZONE=Asia/Kolkata

# Brand & Support Contact Configuration
SUPPORT_EMAIL=contact@kaibuild.space
SALES_EMAIL=sales@kaibuild.space
INFO_EMAIL=info@kaibuild.space
ADMIN_EMAIL=admin@kaibuild.space
