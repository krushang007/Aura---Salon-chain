# Template Environment Configuration (.env.example)
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://salon_admin:salon_password@localhost:5432/salon_booking_dev
POSTGRES_DB=salon_booking_dev
POSTGRES_USER=salon_admin
POSTGRES_PASSWORD=salon_password

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_32_character_jwt_secret_key_here

# GraphQL
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/api/graphql

# Multi-Tenancy
DEFAULT_TENANT_SLUG=bonanza
DEFAULT_TIMEZONE=Asia/Kolkata
