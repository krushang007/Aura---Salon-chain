# ============================================================================
# Production Environment Variables Template (.env.production)
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
NEXTAUTH_URL=https://booking.bonanzasalon.com
NEXTAUTH_SECRET=replace_with_secure_random_32_character_hex

# Database (PostgreSQL via Drizzle ORM)
DATABASE_URL=postgresql://salon_admin:replace_with_secure_password@postgres:5432/salon_booking
POSTGRES_DB=salon_booking
POSTGRES_USER=salon_admin
POSTGRES_PASSWORD=replace_with_secure_password

# GraphQL
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/api/graphql

# Multi-Tenancy & Brand Defaults
DEFAULT_TENANT_SLUG=bonanza
DEFAULT_TIMEZONE=Asia/Kolkata

# Company Contact & Support Configuration
SUPPORT_EMAIL=contact@kaibuild.space
SALES_EMAIL=sales@kaibuild.space
INFO_EMAIL=info@kaibuild.space
ADMIN_EMAIL=admin@kaibuild.space
