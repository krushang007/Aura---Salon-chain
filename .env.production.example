# ============================================================================
# Aura Salon Booking Platform — Production Configuration Template (.env.production)
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database (Supabase Managed Postgres with btree_gist extension)
DATABASE_URL=postgresql://postgres:[YOUR-PRODUCTION-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Production Credentials
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_secret_key

# Authentication & Session Security (Strong 64-char random string in production)
AUTH_SECRET=replace_with_production_random_64_character_hex_secret

# GraphQL API Endpoint
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/api/graphql

# Multi-Tenancy & Regional Defaults
DEFAULT_TENANT_SLUG=bonanza
DEFAULT_TIMEZONE=Asia/Kolkata

# Brand & Support Contact Configuration
SUPPORT_EMAIL=contact@kaibuild.space
SALES_EMAIL=sales@kaibuild.space
INFO_EMAIL=info@kaibuild.space
ADMIN_EMAIL=admin@kaibuild.space
